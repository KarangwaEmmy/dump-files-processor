HOST_DUMP_DIR=/mnt/c/Dump

# API Configuration
API_LOGIN_URL=https://tekana-backend-uat.pepc.rw/users-service/api/v1/auth/signin
API_URL=https://tekana-backend-uat.pepc.rw/vehicle-inspection-service/api/v1/inspectionResult/maha
API_EMAIL=admin@tekana.rw
API_PASSWORD=Qwerty@570
API_TIMEOUT=30000# 

#Remove the broken service
& 'C:\Program Files\nssm\win64\nssm.exe' remove DumpListener confirm

# Wait a moment
Start-Sleep -Seconds 10

# Install with venv Python
& 'C:\Program Files\nssm\win64\nssm.exe' install DumpListener 'C:\dump_listener\venv\Scripts\python.exe'

# Set the working directory
& 'C:\Program Files\nssm\win64\nssm.exe' set DumpListener AppDirectory 'C:\dump_listener'

# Set the script to run
& 'C:\Program Files\nssm\win64\nssm.exe' set DumpListener AppParameters 'main.py'

# Set log files
& 'C:\Program Files\nssm\win64\nssm.exe' set DumpListener AppStdout 'C:\dump_listener\logs\service.log'
& 'C:\Program Files\nssm\win64\nssm.exe' set DumpListener AppStderr 'C:\dump_listener\logs\service_error.log'

# Set to auto-start
& 'C:\Program Files\nssm\win64\nssm.exe' set DumpListener Start SERVICE_AUTO_START

# Start the service
& 'C:\Program Files\nssm\win64\nssm.exe' start DumpListener

# Check status
& 'C:\Program Files\nssm\win64\nssm.exe' status DumpListener